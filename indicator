f_satyLine(satyDraw and satyShowExt, satyUpX3, "Ext ↑ 4.236", satyColExt, line.style_dotted)
f_satyLine(satyDraw and satyShowExt, satyDnX3, "Ext ↓ 4.236", satyColExt, line.style_dotted)

satyZone = not satyOk ? "n/a" : close > satyUpT ? "LONG SIDE" : close < satyDnT ? "SHORT SIDE" : "CHOP"
satyZCol = not satyOk ? #37474f : close > satyUpT ? #2E7D32 : close < satyDnT ? #B71C1C : #546E7A
satyUCol = na(satyUsed) ? #37474f : satyUsed >= 100 ? #E65100 : satyUsed >= 70 ? #F9A825 : #37474f

// ─── BREAK / FAIL STATE MACHINE ──────────────────────────────────────────────
satyNewPeriod = not na(satyPiv) and not na(satyPiv[1]) and satyPiv != satyPiv[1]

var int   satySide = 0
var float satyBest = na
bool  satyFailUp = false
bool  satyFailDn = false
float satyFailRun = na

if satyNewPeriod
    satySide := 0
    satyBest := na

if satyOk and rthNow
    if satySide == 1
        satyBest := na(satyBest) ? high : math.max(satyBest, high)
        if close < satyUpT and (satyBest - satyUpT) >= satyFailMin * satyAtr
            satyFailUp  := true
            satyFailRun := (satyBest - satyPiv) / satyAtr
            satySide    := 0
            satyBest    := na
