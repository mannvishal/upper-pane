satyUpT  = satyPiv + 0.236 * satyAtr
satyDnT  = satyPiv - 0.236 * satyAtr
satyUpM  = satyPiv + 0.618 * satyAtr
satyDnM  = satyPiv - 0.618 * satyAtr
satyUpF  = satyPiv + 1.000 * satyAtr
satyDnF  = satyPiv - 1.000 * satyAtr
satyUpX1 = satyPiv + 1.618 * satyAtr
satyDnX1 = satyPiv - 1.618 * satyAtr
satyUpX2 = satyPiv + 2.618 * satyAtr
satyDnX2 = satyPiv - 2.618 * satyAtr
satyUpX3 = satyPiv + 4.236 * satyAtr
satyDnX3 = satyPiv - 4.236 * satyAtr

var int satyAnchor = na
if na(satyAnchor) or (not na(satyPiv) and not na(satyPiv[1]) and satyPiv != satyPiv[1])
    satyAnchor := bar_index

f_satyLine(_show, _y, _txt, _col, _style) =>
