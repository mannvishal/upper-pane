f_adrPack(_len, _roll) =>
    var float wh = na
    var float wl = na
    if na(wh) or weekofyear != weekofyear[1]
        wh := high
        wl := low
    else
        wh := math.max(wh, high)
        wl := math.min(wl, low)
    [100.0 * (ta.sma(high / low, _len)[1] - 1.0), ta.sma(high - low, _len)[1], high, low, wh, wl, ta.highest(high, _roll), ta.lowest(low, _roll)]

