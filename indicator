// ─── 0DTE REGIME SCORE — CALC + TABLE + ALERT ────────────────────────────────
// v6.28 — the security calls now export the leg's STATE and nothing else; the
// score itself is computed OUTSIDE by f_legAt(). One formula, one place, used
// for the live score AND for every trial price in the solver — so the two can
// never drift apart. (That drift is the exact bug class that has bitten this
// project twice: Python-vs-Pine VWAP renormalization, and the SPX500 CFD.)
// vwapOk crosses as a float because a tuple cannot mix types.
f_zdState() =>
    [macdLine, signalLine, _h] = ta.macd(close, 12, 26, 9)
    vwapv = ta.vwap(hlc3)
    bool vok = not na(vwapv) and timeframe.isintraday
    [ta.ema(close, 9), ta.ema(close, 14), ta.ema(close, 26), ta.ema(close, 12), signalLine, vok ? vwapv : close, ta.rma(math.max(close - close[1], 0.0), 14), ta.rma(math.max(close[1] - close, 0.0), 14), close, vok ? 1.0 : 0.0]

// The score of one leg at ANY price p, from that leg's exported state. At
// p = the leg's own close this reproduces the live score exactly.
f_legAt(_p, _e9, _e14, _e26, _e12, _sg, _vw, _ag, _al, _c, _vo) =>
    float q9  = _e9  + 2.0 / 10.0 * (_p - _e9)
    float q14 = _e14 + 2.0 / 15.0 * (_p - _e14)
    float q26 = _e26 + 2.0 / 27.0 * (_p - _e26)
    float q12 = _e12 + 2.0 / 13.0 * (_p - _e12)
    float st  = (q9 > q14 and q14 > q26) ? 1.0 : (q9 < q14 and q14 < q26) ? -1.0 : (q9 > q26 ? 0.4 : -0.4)
    float ps  = _p > q26 ? 1.0 : -1.0
    float vs  = _vo > 0.5 ? (_p > _vw ? 1.0 : -1.0) : 0.0
    float na_ = (_ag * 13.0 + math.max(_p - _c, 0.0)) / 14.0
    float nl_ = (_al * 13.0 + math.max(_c - _p, 0.0)) / 14.0
    float rv  = nl_ <= 0 ? 100.0 : 100.0 - 100.0 / (1.0 + na_ / nl_)
    float rs  = math.max(-1.0, math.min(1.0, (rv - 50.0) / 25.0))
    float md  = q12 - q26
    float sg2 = _sg + 2.0 / 10.0 * (md - _sg)
    float ms  = md > sg2 ? 1.0 : -1.0
    float mw  = zdWEma + zdWPrice + (_vo > 0.5 ? zdWVwap : 0.0) + zdWRsi + zdWMacd
    mw == 0 ? 0.0 : (st * zdWEma + ps * zdWPrice + vs * zdWVwap + rs * zdWRsi + ms * zdWMacd) / mw * 10.0

f_rsiOf(_ag, _al) => _al <= 0 ? 100.0 : 100.0 - 100.0 / (1.0 + _ag / _al)

zdSymUsed = zdRthData ? ticker.modify(syminfo.tickerid, session.regular) : syminfo.tickerid
[a9, a14, a26, a12, asg, avw, aag, aal, ac, avo] = request.security(zdSymUsed, zdTF1, f_zdState())
[b9, b14, b26, b12, bsg, bvw, bag, bal, bc, bvo] = request.security(zdSymUsed, zdTF2, f_zdState())
[c9, c14, c26, c12, csg, cvw, cag, cal, cc, cvo] = request.security(zdSymUsed, zdTF3, f_zdState())
[d9, d14, d26, d12, dsg, dvw, dag, dal, dc, dvo] = request.security(zdSymUsed, zdTF4, f_zdState())

zdS1 = math.round(f_legAt(ac, a9, a14, a26, a12, asg, avw, aag, aal, ac, avo), 1)
zdS2 = math.round(f_legAt(bc, b9, b14, b26, b12, bsg, bvw, bag, bal, bc, bvo), 1)
zdS3 = math.round(f_legAt(cc, c9, c14, c26, c12, csg, cvw, cag, cal, cc, cvo), 1)
zdS4 = math.round(f_legAt(dc, d9, d14, d26, d12, dsg, dvw, dag, dal, dc, dvo), 1)
zdR1 = f_rsiOf(aag, aal), zdR2 = f_rsiOf(bag, bal)
zdR3 = f_rsiOf(cag, cal), zdR4 = f_rsiOf(dag, dal)

zdOneMin = timeframe.isminutes and timeframe.multiplier == 1
zdLive   = zdOn and (not zdOneMinOnly or zdOneMin)

f_zdVote(_s) => _s > 1.0 ? 1 : _s < -1.0 ? -1 : 0
zdAvg    = (zdS1 + zdS2 + zdS3 + zdS4) / 4.0
zdAvgRsi = (zdR1 + zdR2 + zdR3 + zdR4) / 4.0
zdBulls  = (f_zdVote(zdS1) ==  1 ? 1 : 0) + (f_zdVote(zdS2) ==  1 ? 1 : 0) + (f_zdVote(zdS3) ==  1 ? 1 : 0) + (f_zdVote(zdS4) ==  1 ? 1 : 0)
zdBears  = (f_zdVote(zdS1) == -1 ? 1 : 0) + (f_zdVote(zdS2) == -1 ? 1 : 0) + (f_zdVote(zdS3) == -1 ? 1 : 0) + (f_zdVote(zdS4) == -1 ? 1 : 0)
zdRegime = zdBulls >= 3 ? "UPTREND" : zdBears >= 3 ? "DOWNTREND" : "RANGE"
