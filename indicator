[adrPctRaw, adrPtsRaw, adrDayHi, adrDayLo, adrWkHiRaw, adrWkLoRaw, adrRollHi, adrRollLo] = request.security(lvlTick, "D", f_adrPack(adrLen, adrRollLk), lookahead=barmerge.lookahead_off)
adrByWeek = adrAnchor == "This week's high"
adrRefHi  = adrByWeek ? adrWkHiRaw : adrRollHi
adrRefLo  = adrByWeek ? adrWkLoRaw : adrRollLo
adrRefTxt = adrByWeek ? "this week" : str.tostring(adrRollLk) + "d"

adrUnit  = adrBasis == "Percent" ? adrPctRaw * close / 100.0 : adrPtsRaw
adrPctSh = adrBasis == "Percent" ? adrPctRaw : (close > 0 ? adrPtsRaw / close * 100.0 : na)
adrOk    = not na(adrUnit) and adrUnit > 0
adrRet   = adrOk and not na(adrRefHi) ? (adrRefHi - close) / adrUnit : na
adrExt   = adrOk and not na(adrRefLo) ? (close - adrRefLo) / adrUnit : na
adrRetCol = na(adrRet) ? #37474f : adrRet >= adrHot * 2 ? #880E4F : adrRet >= adrHot ? #D81B60 : adrRet >= adrHot * 0.6 ? #4527A0 : #37474f

if adrAlertOn and rthNow and ta.crossover(adrRet, adrHot)
    alert("ADR PULSE: " + syminfo.ticker + " has retraced " + str.tostring(adrRet, "#.00") + "× its ADR(" + str.tostring(adrLen) + ") from the " + adrRefTxt + " high " + str.tostring(adrRefHi, format.mintick) + " | ADR " + str.tostring(adrPctSh, "#.00") + "% | price " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)


// ─── SATY ATR LEVELS — CALC + LINES + READOUT (0 plot slots) ─────────────────
[satyPiv0, satyAtr0, satyHi0, satyLo0] = request.security(lvlTick, satyTF, [close[1], ta.atr(satyLen)[1], high, low], lookahead=barmerge.lookahead_off)

