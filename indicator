    if barstate.islast
        line.delete(ln)
        label.delete(lb)
        if _show and not na(_y)
            _x1 = satyScope == "Across the chart" ? bar_index - 1 : math.min(satyAnchor, bar_index)
            ln := line.new(_x1, _y, bar_index + satyPad, _y, xloc=xloc.bar_index, extend=(satyScope == "Across the chart" ? extend.both : extend.none), color=_col, style=_style, width=1)
            lb := satyLabels ? label.new(bar_index + satyPad, _y, _txt + "  " + str.tostring(_y, format.mintick), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, size=size.small, textcolor=txtCol(_col), color=_col) : na
    lb

satyDraw = satyOn and satyOk
f_satyLine(satyDraw, satyPiv, "Pivot (prev close)", satyColPiv, line.style_solid)
